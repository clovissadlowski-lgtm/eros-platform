generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  moduleFormat           = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                         String                      @id @default(uuid()) @db.Uuid
  name                       String                      @db.VarChar(150)
  slug                       String                      @unique @db.VarChar(100)
  status                     OrganizationStatus          @default(ACTIVE)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  appointments               Appointment[]
  invitations                Invitation[]
  medicalRecords             MedicalRecord[]
  memberships                Membership[]
  patients                   Patient[]
  professionalScheduleBlocks ProfessionalScheduleBlock[]
  professionalSchedules      ProfessionalSchedule[]

  @@index([status])
  @@map("organizations")
}

model Patient {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  name           String         @db.VarChar(150)
  email          String?        @db.VarChar(255)
  phone          String?        @db.VarChar(30)
  birthDate      DateTime?      @db.Date
  status         PatientStatus  @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  appointments   Appointment[]
  medicalRecord  MedicalRecord?
  organization   Organization   @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, email])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([status])
  @@map("patients")
}

model MedicalRecord {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @db.Uuid
  patientId          String              @db.Uuid
  chiefComplaint     String?
  clinicalHistory    String?
  familyHistory      String?
  allergies          String?
  currentMedications String?
  healthConditions   String?
  clinicalNotes      String?
  treatmentGoals     String?
  status             MedicalRecordStatus @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id])
  patient            Patient             @relation(fields: [organizationId, patientId], references: [organizationId, id])

  @@unique([organizationId, patientId])
  @@index([organizationId])
  @@index([patientId])
  @@index([status])
  @@map("medical_records")
}

model Appointment {
  id                       String            @id @default(uuid()) @db.Uuid
  organizationId           String            @db.Uuid
  patientId                String            @db.Uuid
  professionalMembershipId String            @db.Uuid
  type                     AppointmentType
  status                   AppointmentStatus @default(SCHEDULED)
  scheduledAt              DateTime
  durationMinutes          Int
  reason                   String?
  notes                    String?
  completedAt              DateTime?
  cancelledAt              DateTime?
  cancellationReason       String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  organization             Organization      @relation(fields: [organizationId], references: [id])
  patient                  Patient           @relation(fields: [organizationId, patientId], references: [organizationId, id])
  professionalMembership   Membership        @relation("AppointmentProfessional", fields: [organizationId, professionalMembershipId], references: [organizationId, id])

  @@index([organizationId])
  @@index([patientId])
  @@index([professionalMembershipId])
  @@index([organizationId, scheduledAt])
  @@index([organizationId, status])
  @@index([organizationId, patientId])
  @@index([organizationId, professionalMembershipId])
  @@map("appointments")
}

model ProfessionalSchedule {
  id                       String                           @id @default(uuid()) @db.Uuid
  organizationId           String                           @db.Uuid
  professionalMembershipId String                           @db.Uuid
  timeZone                 String                           @db.VarChar(100)
  slotIntervalMinutes      Int                              @default(30)
  status                   ProfessionalScheduleStatus       @default(ACTIVE)
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt
  availabilityWindows      ProfessionalAvailabilityWindow[]
  blocks                   ProfessionalScheduleBlock[]
  organization             Organization                     @relation(fields: [organizationId], references: [id])
  professionalMembership   Membership                       @relation(fields: [organizationId, professionalMembershipId], references: [organizationId, id])

  @@unique([organizationId, professionalMembershipId])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([professionalMembershipId])
  @@index([organizationId, status])
  @@map("professional_schedules")
}

model ProfessionalAvailabilityWindow {
  id                     String               @id @default(uuid()) @db.Uuid
  organizationId         String               @db.Uuid
  professionalScheduleId String               @db.Uuid
  weekday                Weekday
  startMinute            Int
  endMinute              Int
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  professionalSchedule   ProfessionalSchedule @relation(fields: [organizationId, professionalScheduleId], references: [organizationId, id], onDelete: Cascade)

  @@unique([professionalScheduleId, weekday, startMinute, endMinute])
  @@index([organizationId])
  @@index([professionalScheduleId])
  @@index([professionalScheduleId, weekday])
  @@map("professional_availability_windows")
}

model ProfessionalScheduleBlock {
  id                     String                        @id @default(uuid()) @db.Uuid
  organizationId         String                        @db.Uuid
  professionalScheduleId String                        @db.Uuid
  type                   ProfessionalScheduleBlockType
  startsAt               DateTime
  endsAt                 DateTime
  reason                 String?                       @db.VarChar(500)
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  organization           Organization                  @relation(fields: [organizationId], references: [id])
  professionalSchedule   ProfessionalSchedule          @relation(fields: [organizationId, professionalScheduleId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId], map: "ps_blocks_organization_idx")
  @@index([professionalScheduleId], map: "ps_blocks_schedule_idx")
  @@index([organizationId, professionalScheduleId], map: "ps_blocks_org_schedule_idx")
  @@index([organizationId, professionalScheduleId, startsAt], map: "ps_blocks_org_schedule_start_idx")
  @@index([organizationId, professionalScheduleId, endsAt], map: "ps_blocks_org_schedule_end_idx")
  @@map("professional_schedule_blocks")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @db.VarChar(150)
  email        String       @unique @db.VarChar(255)
  passwordHash String?      @db.VarChar(255)
  status       UserStatus   @default(INVITED)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  invitations  Invitation[]
  memberships  Membership[]
  sessions     Session[]

  @@index([status])
  @@map("users")
}

model Membership {
  id                       String                @id @default(uuid()) @db.Uuid
  userId                   String                @db.Uuid
  organizationId           String                @db.Uuid
  role                     MembershipRole
  status                   MembershipStatus      @default(INVITED)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  professionalAppointments Appointment[]         @relation("AppointmentProfessional")
  createdInvitations       Invitation[]          @relation("InvitationCreatorMembership")
  invitations              Invitation[]          @relation("InvitationMembership")
  organization             Organization          @relation(fields: [organizationId], references: [id])
  user                     User                  @relation(fields: [userId], references: [id])
  professionalSchedule     ProfessionalSchedule?

  @@unique([userId, organizationId])
  @@unique([organizationId, id])
  @@index([userId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, role])
  @@map("memberships")
}

model Invitation {
  id                    String           @id @default(uuid()) @db.Uuid
  organizationId        String           @db.Uuid
  userId                String           @db.Uuid
  membershipId          String           @db.Uuid
  email                 String           @db.VarChar(255)
  role                  MembershipRole
  tokenHash             String           @unique @db.VarChar(64)
  status                InvitationStatus @default(PENDING)
  expiresAt             DateTime
  acceptedAt            DateTime?
  revokedAt             DateTime?
  createdByMembershipId String           @db.Uuid
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  createdByMembership   Membership       @relation("InvitationCreatorMembership", fields: [createdByMembershipId], references: [id])
  membership            Membership       @relation("InvitationMembership", fields: [membershipId], references: [id])
  organization          Organization     @relation(fields: [organizationId], references: [id])
  user                  User             @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([membershipId])
  @@index([createdByMembershipId])
  @@index([status])
  @@index([expiresAt])
  @@index([organizationId, email, status])
  @@map("invitations")
}

model Session {
  id                     String        @id @default(uuid()) @db.Uuid
  userId                 String        @db.Uuid
  selectedOrganizationId String?       @db.Uuid
  refreshTokenHash       String        @unique @db.VarChar(64)
  ipAddress              String?       @db.VarChar(64)
  userAgent              String?       @db.VarChar(500)
  expiresAt              DateTime
  lastUsedAt             DateTime?
  revokedAt              DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([selectedOrganizationId])
  @@map("sessions")
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum PatientStatus {
  ACTIVE
  INACTIVE
}

enum MedicalRecordStatus {
  ACTIVE
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  BLOCKED
  INACTIVE
}

enum MembershipRole {
  OWNER
  ADMIN
  NUTRITIONIST
  ASSISTANT
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AppointmentType {
  INITIAL
  FOLLOW_UP
  REVIEW
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ProfessionalScheduleStatus {
  ACTIVE
  INACTIVE
}

enum ProfessionalScheduleBlockType {
  PERSONAL
  MEETING
  VACATION
  HOLIDAY
  OTHER
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
