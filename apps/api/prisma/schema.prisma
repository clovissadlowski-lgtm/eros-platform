generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  moduleFormat           = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                         String                      @id @default(uuid()) @db.Uuid
  name                       String                      @db.VarChar(150)
  slug                       String                      @unique @db.VarChar(100)
  status                     OrganizationStatus          @default(ACTIVE)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  appointments               Appointment[]
  invitations                Invitation[]
  medicalRecords             MedicalRecord[]
  memberships                Membership[]
  patients                   Patient[]
  professionalScheduleBlocks ProfessionalScheduleBlock[]
  professionalSchedules      ProfessionalSchedule[]

  @@index([status])
  @@map("organizations")
}

model Patient {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  name           String                @db.VarChar(150)
  cpf            String?               @db.VarChar(11)
  email          String?               @db.VarChar(255)
  phone          String?               @db.VarChar(30)
  birthDate      DateTime?             @db.Date
  biologicalSex  PatientBiologicalSex?
  status         PatientStatus         @default(ACTIVE)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  appointments   Appointment[]
  medicalRecord  MedicalRecord?
  organization   Organization          @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, cpf])
  @@unique([organizationId, email])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([status])
  @@map("patients")
}

model MedicalRecord {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @db.Uuid
  patientId          String              @db.Uuid
  chiefComplaint     String?
  clinicalHistory    String?
  familyHistory      String?
  allergies          String?
  currentMedications String?
  healthConditions   String?
  clinicalNotes      String?
  treatmentGoals     String?
  status             MedicalRecordStatus @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id])
  patient            Patient             @relation(fields: [organizationId, patientId], references: [organizationId, id])

  healthConditionEntries    MedicalRecordHealthCondition[]
  medicationEntries         MedicalRecordMedication[]
  allergyEntries            MedicalRecordAllergy[]
  dietaryRestrictionEntries MedicalRecordDietaryRestriction[]
  laboratoryExams           LaboratoryExam[]

  @@unique([organizationId, patientId])
  @@index([organizationId])
  @@index([patientId])
  @@index([status])
  @@map("medical_records")
}

model MedicalRecordHealthCondition {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @db.Uuid
  medicalRecordId String @db.Uuid
  patientId       String @db.Uuid

  clinicalConditionId String? @db.Uuid

  name   String                @db.VarChar(200)
  status HealthConditionStatus @default(ACTIVE)

  diagnosedAt DateTime? @db.Date
  resolvedAt  DateTime? @db.Date

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  clinicalCondition ClinicalConditionCatalog? @relation(fields: [clinicalConditionId], references: [id])

  @@index([organizationId])
  @@index([medicalRecordId])
  @@index([patientId])
  @@index([clinicalConditionId])
  @@index([organizationId, patientId])
  @@index([status])
  @@map("medical_record_health_conditions")
}

model MedicalRecordMedication {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @db.Uuid
  medicalRecordId String @db.Uuid
  patientId       String @db.Uuid

  medicationCatalogId String? @db.Uuid

  name      String           @db.VarChar(200)
  dosage    String?          @db.VarChar(100)
  frequency String?          @db.VarChar(100)
  route     MedicationRoute?

  indication String? @db.VarChar(500)

  startedAt DateTime? @db.Date
  endedAt   DateTime? @db.Date

  status MedicationStatus @default(ACTIVE)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  medicationCatalog MedicationCatalog? @relation(fields: [medicationCatalogId], references: [id])

  @@index([organizationId])
  @@index([medicalRecordId])
  @@index([patientId])
  @@index([medicationCatalogId])
  @@index([organizationId, patientId])
  @@index([status])
  @@map("medical_record_medications")
}

model MedicationCatalog {
  id String @id @default(uuid()) @db.Uuid

  name           String @db.VarChar(200)
  normalizedName String @unique @db.VarChar(200)

  activeIngredient           String @db.VarChar(200)
  normalizedActiveIngredient String @db.VarChar(200)

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  synonyms          MedicationSynonym[]
  externalCodes     MedicationExternalCode[]
  medicationEntries MedicalRecordMedication[]

  @@index([name])
  @@index([normalizedName])
  @@index([activeIngredient])
  @@index([normalizedActiveIngredient])
  @@index([isActive])
  @@map("medication_catalog")
}

model MedicationSynonym {
  id String @id @default(uuid()) @db.Uuid

  medicationCatalogId String @db.Uuid

  term           String @db.VarChar(200)
  normalizedTerm String @db.VarChar(200)

  type MedicationSynonymType @default(OTHER)

  createdAt DateTime @default(now())

  medicationCatalog MedicationCatalog @relation(fields: [medicationCatalogId], references: [id], onDelete: Cascade)

  @@unique([medicationCatalogId, normalizedTerm])
  @@index([normalizedTerm])
  @@index([medicationCatalogId])
  @@index([type])
  @@map("medication_synonyms")
}

model MedicationExternalCode {
  id String @id @default(uuid()) @db.Uuid

  medicationCatalogId String @db.Uuid

  system MedicationTerminologySystem

  code String @db.VarChar(100)

  display String? @db.VarChar(250)

  version String? @db.VarChar(50)

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicationCatalog MedicationCatalog @relation(fields: [medicationCatalogId], references: [id], onDelete: Cascade)

  @@unique([system, code])
  @@index([medicationCatalogId])
  @@index([system])
  @@index([code])
  @@index([system, code])
  @@map("medication_external_codes")
}

model MedicalRecordAllergy {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @db.Uuid
  medicalRecordId String @db.Uuid
  patientId       String @db.Uuid

  allergenCatalogId String? @db.Uuid

  substance String @db.VarChar(200)

  type AllergyType

  reaction String? @db.VarChar(500)

  severity AllergySeverity?

  status AllergyStatus @default(ACTIVE)

  identifiedAt DateTime? @db.Date

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  allergenCatalog AllergenCatalog? @relation(fields: [allergenCatalogId], references: [id])

  @@index([organizationId])
  @@index([medicalRecordId])
  @@index([patientId])
  @@index([allergenCatalogId])
  @@index([organizationId, patientId])
  @@index([type])
  @@index([severity])
  @@index([status])
  @@map("medical_record_allergies")
}

model MedicalRecordDietaryRestriction {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @db.Uuid
  medicalRecordId String @db.Uuid
  patientId       String @db.Uuid

  dietaryItemCatalogId String? @db.Uuid

  item   String                   @db.VarChar(200)
  type   DietaryRestrictionType
  action DietaryRestrictionAction
  risk   DietaryRestrictionRisk   @default(NONE)
  source DietaryRestrictionSource @default(PATIENT_REPORTED)

  reason       String?   @db.VarChar(500)
  identifiedAt DateTime? @db.Date

  status DietaryRestrictionStatus @default(ACTIVE)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  dietaryItemCatalog DietaryItemCatalog? @relation(fields: [dietaryItemCatalogId], references: [id])

  @@index([organizationId])
  @@index([medicalRecordId])
  @@index([patientId])
  @@index([dietaryItemCatalogId])
  @@index([organizationId, patientId])
  @@index([type])
  @@index([action])
  @@index([risk])
  @@index([status])
  @@map("medical_record_dietary_restrictions")
}

model DietaryItemCatalog {
  id String @id @default(uuid()) @db.Uuid

  name           String @db.VarChar(200)
  normalizedName String @unique @db.VarChar(200)

  type DietaryItemCatalogType

  category String? @db.VarChar(100)

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  synonyms           DietaryItemSynonym[]
  restrictionEntries MedicalRecordDietaryRestriction[]

  @@index([name])
  @@index([normalizedName])
  @@index([type])
  @@index([category])
  @@index([isActive])
  @@map("dietary_item_catalog")
}

model DietaryItemSynonym {
  id String @id @default(uuid()) @db.Uuid

  dietaryItemCatalogId String @db.Uuid

  term           String @db.VarChar(200)
  normalizedTerm String @db.VarChar(200)

  createdAt DateTime @default(now())

  dietaryItemCatalog DietaryItemCatalog @relation(fields: [dietaryItemCatalogId], references: [id], onDelete: Cascade)

  @@unique([dietaryItemCatalogId, normalizedTerm])
  @@index([normalizedTerm])
  @@index([dietaryItemCatalogId])
  @@map("dietary_item_synonyms")
}

model AllergenCatalog {
  id String @id @default(uuid()) @db.Uuid

  name           String @db.VarChar(200)
  normalizedName String @unique @db.VarChar(200)

  type AllergenCatalogType

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  synonyms       AllergenSynonym[]
  externalCodes  AllergenExternalCode[]
  allergyEntries MedicalRecordAllergy[]

  @@index([name])
  @@index([normalizedName])
  @@index([type])
  @@index([isActive])
  @@map("allergen_catalog")
}

model AllergenSynonym {
  id String @id @default(uuid()) @db.Uuid

  allergenCatalogId String @db.Uuid

  term           String @db.VarChar(200)
  normalizedTerm String @db.VarChar(200)

  createdAt DateTime @default(now())

  allergenCatalog AllergenCatalog @relation(fields: [allergenCatalogId], references: [id], onDelete: Cascade)

  @@unique([allergenCatalogId, normalizedTerm])
  @@index([normalizedTerm])
  @@index([allergenCatalogId])
  @@map("allergen_synonyms")
}

model AllergenExternalCode {
  id String @id @default(uuid()) @db.Uuid

  allergenCatalogId String @db.Uuid

  system AllergenTerminologySystem

  code String @db.VarChar(100)

  display String? @db.VarChar(250)

  version String? @db.VarChar(50)

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allergenCatalog AllergenCatalog @relation(fields: [allergenCatalogId], references: [id], onDelete: Cascade)

  @@unique([system, code])
  @@index([allergenCatalogId])
  @@index([system])
  @@index([code])
  @@index([system, code])
  @@map("allergen_external_codes")
}

model ClinicalConditionCatalog {
  id String @id @default(uuid()) @db.Uuid

  name           String @db.VarChar(200)
  normalizedName String @unique @db.VarChar(200)

  conceptType ClinicalConceptType @default(CONDITION)

  category String? @db.VarChar(100)

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  synonyms               ClinicalConditionSynonym[]
  externalCodes          ClinicalConditionExternalCode[]
  healthConditionEntries MedicalRecordHealthCondition[]

  @@index([name])
  @@index([normalizedName])
  @@index([conceptType])
  @@index([category])
  @@index([isActive])
  @@map("clinical_condition_catalog")
}

model ClinicalConditionSynonym {
  id String @id @default(uuid()) @db.Uuid

  clinicalConditionId String @db.Uuid

  term           String @db.VarChar(200)
  normalizedTerm String @db.VarChar(200)

  createdAt DateTime @default(now())

  clinicalCondition ClinicalConditionCatalog @relation(fields: [clinicalConditionId], references: [id], onDelete: Cascade)

  @@unique([clinicalConditionId, normalizedTerm])
  @@index([normalizedTerm])
  @@index([clinicalConditionId])
  @@map("clinical_condition_synonyms")
}

model ClinicalConditionExternalCode {
  id String @id @default(uuid()) @db.Uuid

  clinicalConditionId String @db.Uuid

  system TerminologySystem

  code String @db.VarChar(100)

  display String? @db.VarChar(250)

  version String? @db.VarChar(50)

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinicalCondition ClinicalConditionCatalog @relation(fields: [clinicalConditionId], references: [id], onDelete: Cascade)

  @@unique([system, code])
  @@index([clinicalConditionId])
  @@index([system])
  @@index([code])
  @@index([system, code])
  @@map("clinical_condition_external_codes")
}

model Appointment {
  id                       String            @id @default(uuid()) @db.Uuid
  organizationId           String            @db.Uuid
  patientId                String            @db.Uuid
  professionalMembershipId String            @db.Uuid
  type                     AppointmentType
  status                   AppointmentStatus @default(SCHEDULED)
  scheduledAt              DateTime
  durationMinutes          Int
  reason                   String?
  notes                    String?
  completedAt              DateTime?
  cancelledAt              DateTime?
  cancellationReason       String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  organization             Organization      @relation(fields: [organizationId], references: [id])
  patient                  Patient           @relation(fields: [organizationId, patientId], references: [organizationId, id])
  professionalMembership   Membership        @relation("AppointmentProfessional", fields: [organizationId, professionalMembershipId], references: [organizationId, id])

  @@index([organizationId])
  @@index([patientId])
  @@index([professionalMembershipId])
  @@index([organizationId, scheduledAt])
  @@index([organizationId, status])
  @@index([organizationId, patientId])
  @@index([organizationId, professionalMembershipId])
  @@map("appointments")
}

model ProfessionalSchedule {
  id                       String                     @id @default(uuid()) @db.Uuid
  organizationId           String                     @db.Uuid
  professionalMembershipId String                     @db.Uuid
  timeZone                 String                     @db.VarChar(100)
  slotIntervalMinutes      Int                        @default(30)
  status                   ProfessionalScheduleStatus @default(ACTIVE)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  availabilityWindows ProfessionalAvailabilityWindow[]
  blocks              ProfessionalScheduleBlock[]

  organization           Organization @relation(fields: [organizationId], references: [id])
  professionalMembership Membership   @relation(fields: [organizationId, professionalMembershipId], references: [organizationId, id])

  @@unique([organizationId, professionalMembershipId])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([professionalMembershipId])
  @@index([organizationId, status])
  @@map("professional_schedules")
}

model ProfessionalAvailabilityWindow {
  id                     String   @id @default(uuid()) @db.Uuid
  organizationId         String   @db.Uuid
  professionalScheduleId String   @db.Uuid
  weekday                Weekday
  startMinute            Int
  endMinute              Int
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  professionalSchedule ProfessionalSchedule @relation(fields: [organizationId, professionalScheduleId], references: [organizationId, id], onDelete: Cascade)

  @@unique([professionalScheduleId, weekday, startMinute, endMinute])
  @@index([organizationId])
  @@index([professionalScheduleId])
  @@index([professionalScheduleId, weekday])
  @@map("professional_availability_windows")
}

model ProfessionalScheduleBlock {
  id                     String                        @id @default(uuid()) @db.Uuid
  organizationId         String                        @db.Uuid
  professionalScheduleId String                        @db.Uuid
  type                   ProfessionalScheduleBlockType
  startsAt               DateTime
  endsAt                 DateTime
  reason                 String?                       @db.VarChar(500)
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  organization         Organization         @relation(fields: [organizationId], references: [id])
  professionalSchedule ProfessionalSchedule @relation(fields: [organizationId, professionalScheduleId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId], map: "ps_blocks_organization_idx")
  @@index([professionalScheduleId], map: "ps_blocks_schedule_idx")
  @@index([organizationId, professionalScheduleId], map: "ps_blocks_org_schedule_idx")
  @@index([organizationId, professionalScheduleId, startsAt], map: "ps_blocks_org_schedule_start_idx")
  @@index([organizationId, professionalScheduleId, endsAt], map: "ps_blocks_org_schedule_end_idx")
  @@map("professional_schedule_blocks")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(150)
  email        String     @unique @db.VarChar(255)
  passwordHash String?    @db.VarChar(255)
  status       UserStatus @default(INVITED)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  invitations Invitation[]
  memberships Membership[]
  sessions    Session[]

  @@index([status])
  @@map("users")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(INVITED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  professionalAppointments Appointment[]         @relation("AppointmentProfessional")
  createdInvitations       Invitation[]          @relation("InvitationCreatorMembership")
  invitations              Invitation[]          @relation("InvitationMembership")
  organization             Organization          @relation(fields: [organizationId], references: [id])
  user                     User                  @relation(fields: [userId], references: [id])
  professionalSchedule     ProfessionalSchedule?

  @@unique([userId, organizationId])
  @@unique([organizationId, id])
  @@index([userId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, role])
  @@map("memberships")
}

model Invitation {
  id                    String           @id @default(uuid()) @db.Uuid
  organizationId        String           @db.Uuid
  userId                String           @db.Uuid
  membershipId          String           @db.Uuid
  email                 String           @db.VarChar(255)
  role                  MembershipRole
  tokenHash             String           @unique @db.VarChar(64)
  status                InvitationStatus @default(PENDING)
  expiresAt             DateTime
  acceptedAt            DateTime?
  revokedAt             DateTime?
  createdByMembershipId String           @db.Uuid
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  createdByMembership Membership   @relation("InvitationCreatorMembership", fields: [createdByMembershipId], references: [id])
  membership          Membership   @relation("InvitationMembership", fields: [membershipId], references: [id])
  organization        Organization @relation(fields: [organizationId], references: [id])
  user                User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([membershipId])
  @@index([createdByMembershipId])
  @@index([status])
  @@index([expiresAt])
  @@index([organizationId, email, status])
  @@map("invitations")
}

model Session {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @db.Uuid
  selectedOrganizationId String?   @db.Uuid
  refreshTokenHash       String    @unique @db.VarChar(64)
  ipAddress              String?   @db.VarChar(64)
  userAgent              String?   @db.VarChar(500)
  expiresAt              DateTime
  lastUsedAt             DateTime?
  revokedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([selectedOrganizationId])
  @@map("sessions")
}

model BiomarkerCatalog {
  id String @id @default(uuid()) @db.Uuid

  name String @db.VarChar(200)

  code String? @db.VarChar(100)

  defaultUnit String? @db.VarChar(50)

  description String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  laboratoryResults LaboratoryResult[]
  referenceRanges   BiomarkerReferenceRange[]

  @@index([name])
  @@index([code])
  @@index([active])
  @@map("biomarker_catalog")
}

model BiomarkerReferenceRange {
  id String @id @default(uuid()) @db.Uuid

  biomarkerCatalogId String @db.Uuid

  unit String @db.VarChar(50)

  minAgeYears Int?
  maxAgeYears Int?

  lowerBound Decimal? @db.Decimal(18, 6)
  upperBound Decimal? @db.Decimal(18, 6)

  sex BiomarkerReferenceSex @default(ANY)

  context BiomarkerReferenceContext @default(GENERAL)

  sourceName String? @db.VarChar(200)
  sourceUrl  String? @db.VarChar(500)
  sourceNote String? @db.VarChar(500)

  description String? @db.VarChar(500)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  biomarkerCatalog BiomarkerCatalog @relation(fields: [biomarkerCatalogId], references: [id], onDelete: Cascade)

  @@index([biomarkerCatalogId])
  @@index([biomarkerCatalogId, unit])
  @@index([active])
  @@map("biomarker_reference_ranges")
}

model LaboratoryExam {
  id String @id @default(uuid()) @db.Uuid

  organizationId  String @db.Uuid
  medicalRecordId String @db.Uuid
  patientId       String @db.Uuid

  name String @db.VarChar(200)

  laboratoryName String? @db.VarChar(200)

  collectedAt DateTime? @db.Date
  resultedAt  DateTime? @db.Date

  collectionContext BiomarkerReferenceContext?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  results LaboratoryResult[]

  @@index([organizationId])
  @@index([medicalRecordId])
  @@index([patientId])
  @@index([organizationId, patientId])
  @@index([collectedAt])
  @@map("laboratory_exams")
}

model LaboratoryResult {
  id String @id @default(uuid()) @db.Uuid

  laboratoryExamId String @db.Uuid

  biomarkerCatalogId String? @db.Uuid

  name String @db.VarChar(200)

  value Decimal? @db.Decimal(18, 6)

  textValue String? @db.VarChar(500)

  unit String? @db.VarChar(50)

  referenceRange String? @db.VarChar(200)

  interpretation LaboratoryResultInterpretation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  laboratoryExam LaboratoryExam @relation(fields: [laboratoryExamId], references: [id], onDelete: Cascade)

  biomarkerCatalog BiomarkerCatalog? @relation(fields: [biomarkerCatalogId], references: [id])

  @@index([laboratoryExamId])
  @@index([biomarkerCatalogId])
  @@index([name])
  @@index([interpretation])
  @@map("laboratory_results")
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum HealthConditionStatus {
  ACTIVE
  CONTROLLED
  RESOLVED
  INACTIVE
}

enum MedicationStatus {
  ACTIVE
  SUSPENDED
  COMPLETED
  DISCONTINUED
}

enum MedicationRoute {
  ORAL
  SUBCUTANEOUS
  INTRAMUSCULAR
  INTRAVENOUS
  TOPICAL
  INHALATION
  SUBLINGUAL
  RECTAL
  VAGINAL
  OPHTHALMIC
  OTIC
  NASAL
  OTHER
}

enum PatientStatus {
  ACTIVE
  INACTIVE
}

enum MedicalRecordStatus {
  ACTIVE
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  BLOCKED
  INACTIVE
}

enum MembershipRole {
  OWNER
  ADMIN
  NUTRITIONIST
  ASSISTANT
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AppointmentType {
  INITIAL
  FOLLOW_UP
  REVIEW
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ProfessionalScheduleStatus {
  ACTIVE
  INACTIVE
}

enum ProfessionalScheduleBlockType {
  PERSONAL
  MEETING
  VACATION
  HOLIDAY
  OTHER
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AllergyType {
  MEDICATION
  FOOD
  ENVIRONMENTAL
  CONTACT
  OTHER
